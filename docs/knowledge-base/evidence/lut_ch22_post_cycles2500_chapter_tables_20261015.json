{
 "date": "2026-10-15",
 "exe_md5": "33464c81e6a364fd0660141139aa8e6e",
 "method": "DOSBox-X 除錯器斷點(core=normal;harness cycles=5000,cycles 2500 那兩份經包裝腳本只換 cycles);只改模擬器記憶體裡的資料,程式碼不動。計時讀線性 0x46c 的 BIOS tick(約 54.93 ms);停在除錯器時模擬器不跑。",
 "abandoned_first_attempt": {
  "instance": "lc127",
  "note": "先用 cl.py battle 把預設存檔的章節位元組改成 22:出戰選擇格只有 12 名候選、目標 15,選不滿。在 0x2b0e3 cmp eax, ebp 把 EBP 改成已選人數(兩次:11、12),遊戲兩次都顯示「本章希爾法必須出場」退回選擇畫面(這份存檔沒有希爾法)。放棄這個 instance,沒有任何紀錄出自它。"
 },
 "ch22_roster": "prepare_chapter_save 的完整隊伍 16 人(roster_cap=16),選擇格 15 名全選,遊戲自己的 cmp eax, ebp 成立後進戰場,沒有改暫存器。",
 "cycles_wrapper": "#!/bin/bash\n# 續一百二十七:只把 harness 傳來的 \"config -set cycles=5000\" 換成 2500,其他參數原樣交給同一個 calllog 版 dosbox-x。\n# harness 第 337 行以 grep FD2_CALLLOG_ENTRIES 確認 binary 有 call-log 修補;實際執行的就是下面那個有修補的 binary。\nargs=()\nn=0\nfor a in \"$@\"; do\n  if [ \"$a\" = \"config -set cycles=5000\" ]; then\n    a=\"config -set cycles=2500\"\n    n=$((n + 1))\n  fi\n  args+=(\"$a\")\ndone\necho \"wrap cycles replaced=$n\" > \"$PWD/WRAP_CYCLES.TXT\"\nexec /home/kg701004/fd2-dosbox-calllog/dosbox-x/src/dosbox-x \"${args[@]}\"\n",
